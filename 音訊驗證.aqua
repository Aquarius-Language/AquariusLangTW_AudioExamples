變數 音訊 = 匯入("音訊");
變數 裝置 = 音訊.建立離線裝置();
變數 音調 = 裝置.建立音調(440, 0.1d);
音調.設定音量(0.5d); 音調.播放();
變數 樣本 = 裝置.產生樣本(512);
變數 有聲音 = 假;
迴圈 (變數 項 = 0; 項 < 長度(樣本); 項++) { 如果 (樣本[項] > 0.01d) { 有聲音 = 真; } }
變數 成功 = 有聲音 && 長度(樣本) == 1024 && 音調.取得時長() == 0.1d && 音調.是否播放中();
音調.暫停(); 成功 = 成功 && !音調.是否播放中();
音調.停止(); 成功 = 成功 && 音調.取得位置() == 0.0d;
音調.設定循環(真); 音調.播放(); 裝置.產生樣本(4096); 裝置.產生樣本(4096);
成功 = 成功 && 音調.是否播放中(); 音調.釋放();
變數 音檔 = 裝置.載入(目前工作目錄 + "/音色/星泉提示.wav"); 音檔.播放();
變數 音檔樣本 = 裝置.產生樣本(512);
成功 = 成功 && 長度(音檔樣本) == 1024 && 音檔.取得時長() > 0.5d;
音檔.釋放(); 裝置.釋放(); 裝置.釋放();
如果 (成功) { 印出("音訊驗證全部通過"); } 否則 { 印出("音訊驗證失敗"); }
成功;
