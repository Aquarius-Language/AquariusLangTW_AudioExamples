# 星泉既有的繪圖協定名稱集中在本檔；所有宣告、呼叫與對外介面均為繁體中文。
變數 繪圖 = 匯入("Processing");
變數 開啟視窗 = 函式() { 繪圖.尺寸(1120, 780, "P2D", "星泉聲音工坊"); };
變數 寬度 = 函式() { 回傳 繪圖.width; };
變數 高度 = 函式() { 回傳 繪圖.height; };
變數 滑鼠橫座標 = 函式() { 回傳 繪圖.mouseX; };
變數 滑鼠縱座標 = 函式() { 回傳 繪圖.mouseY; };
變數 按鍵代碼 = 函式() { 回傳 繪圖.keyCode; };
變數 註冊點擊 = 函式(處理) { 繪圖.註冊事件("mousePressed", 處理); };
變數 註冊按鍵 = 函式(處理) { 繪圖.註冊事件("keyPressed", 處理); };
