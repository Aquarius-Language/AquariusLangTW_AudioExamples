變數 介面 = 匯入("中文介面.aqua");
變數 畫 = 介面.繪圖;
變數 音訊 = 匯入("音訊");
變數 裝置 = 0;
變數 準備完成 = 假;
變數 音符 = [];
變數 頻率 = [261.63d, 293.66d, 329.63d, 349.23d, 392.0d, 440.0d, 493.88d, 523.25d];
變數 音名 = ["哆", "來", "咪", "發", "嗦", "啦", "西", "哆"];
變數 循環音 = 0;
變數 音檔 = 0;
變數 循環中 = 假;
變數 音量 = 0.65d;
變數 聲像 = 0.0d;
變數 音高 = 1.0d;
變數 聲像名稱 = "中央";
變數 音高名稱 = "原音";
變數 訊息 = "點選琴鍵，開啟你的第一個聲音。";
變數 比例 = 1.0d;
變數 左邊 = 0.0d;
變數 上邊 = 0.0d;
變數 活動琴鍵 = -1;
變數 琴鍵時間 = 0;
變數 旋律中 = 假;
變數 旋律 = [0, 2, 4, 7, 4, 2, 1, 3, 5, 7, 5, 3, 0];
變數 旋律位置 = 0;
變數 下個音符時間 = 0;
變數 波形 = [];

變數 準備音訊 = 函式() {
    如果 (!準備完成) {
        裝置 = 音訊.建立裝置();
        迴圈 (變數 項 = 0; 項 < 8; 項++) { 音符 = 加入(音符, 裝置.建立音調(頻率[項], 0.38d)); }
        循環音 = 裝置.建立音調(130.81d, 2.0d);
        循環音.設定循環(真);
        音檔 = 裝置.載入(目前工作目錄 + "/音色/星泉提示.wav");
        裝置.啟動();
        準備完成 = 真;
    }
};
變數 套用設定 = 函式(聲音) { 聲音.設定音量(音量); 聲音.設定聲像(聲像); 聲音.設定音高(音高); };
變數 彈奏 = 函式(項) {
    準備音訊(); 套用設定(音符[項]); 音符[項].停止(); 音符[項].播放();
    活動琴鍵 = 項; 琴鍵時間 = 畫.毫秒(); 訊息 = "正在彈奏：「" + 音名[項] + "」。";
};
變數 全部停止 = 函式() {
    旋律中 = 假; 循環中 = 假;
    如果 (準備完成) {
        迴圈 (變數 項 = 0; 項 < 8; 項++) { 音符[項].停止(); }
        循環音.停止(); 音檔.停止();
    }
    訊息 = "所有聲音已停止。";
};
變數 命中 = 函式(橫, 縱, 左, 上, 寬, 高) { 回傳 橫 >= 左 && 縱 >= 上 && 橫 <= 左 + 寬 && 縱 <= 上 + 高; };
變數 處理點擊 = 函式() {
    變數 橫 = (介面.滑鼠橫座標() - 左邊) / 比例;
    變數 縱 = (介面.滑鼠縱座標() - 上邊) / 比例;
    迴圈 (變數 項 = 0; 項 < 8; 項++) { 如果 (命中(橫, 縱, 40 + 項 * 130, 190, 120, 180)) { 彈奏(項); } }
    如果 (命中(橫, 縱, 40, 404, 236, 58)) { 準備音訊(); 旋律中 = 真; 旋律位置 = 0; 下個音符時間 = 0; 訊息 = "以星泉程式排列音符，奏出一段旋律。"; }
    如果 (命中(橫, 縱, 294, 404, 236, 58)) {
        準備音訊(); 循環中 = !循環中;
        如果 (循環中) { 套用設定(循環音); 循環音.播放(); 訊息 = "低音循環中，可與琴鍵一起混音。"; }
        否則 { 循環音.停止(); 訊息 = "循環已停止。"; }
    }
    如果 (命中(橫, 縱, 548, 404, 236, 58)) { 準備音訊(); 套用設定(音檔); 音檔.停止(); 音檔.播放(); 訊息 = "播放封裝在專案內的原創音檔。"; }
    如果 (命中(橫, 縱, 802, 404, 236, 58)) { 全部停止(); }
    如果 (命中(橫, 縱, 40, 490, 320, 54)) { 如果 (音量 > 0.5d) { 音量 = 0.3d; 訊息 = "音量：輕柔。"; } 否則 { 音量 = 0.65d; 訊息 = "音量：標準。"; } }
    如果 (命中(橫, 縱, 380, 490, 320, 54)) {
        如果 (聲像 == 0.0d) { 聲像 = -0.8d; 聲像名稱 = "左側"; }
        否則如果 (聲像 < 0.0d) { 聲像 = 0.8d; 聲像名稱 = "右側"; }
        否則 { 聲像 = 0.0d; 聲像名稱 = "中央"; }
        訊息 = "聲像已切換；使用耳機可聽見方向。";
    }
    如果 (命中(橫, 縱, 720, 490, 320, 54)) {
        如果 (音高 == 1.0d) { 音高 = 1.5d; 音高名稱 = "明亮"; }
        否則如果 (音高 > 1.0d) { 音高 = 0.75d; 音高名稱 = "低沉"; }
        否則 { 音高 = 1.0d; 音高名稱 = "原音"; }
        訊息 = "音高已切換，下一個音符立即套用。";
    }
    如果 (準備完成 && 循環中) { 套用設定(循環音); }
};
變數 處理按鍵 = 函式() {
    變數 代碼 = 介面.按鍵代碼();
    如果 (代碼 >= 49 && 代碼 <= 56) { 彈奏(代碼 - 49); }
    如果 (代碼 == 32) { 全部停止(); }
};
變數 文字 = 函式(內容, 橫, 縱, 大小, 紅, 綠, 藍) {
    畫.填色(紅, 綠, 藍); 畫.文字大小(大小); 畫.文字(內容, 橫, 縱);
};
變數 按鈕 = 函式(內容, 左, 上, 寬, 啟用) {
    畫.停用描邊(); 畫.填色(29, 48, 61); 如果 (啟用) { 畫.填色(36, 117, 109); }
    畫.矩形(左, 上, 寬, 58, 12); 文字(內容, 左 + 18, 上 + 36, 18, 225, 242, 238);
};
變數 設定 = 函式() {
    介面.開啟視窗(); 畫.影格率(60); 畫.文字字型(畫.建立字型("sans-serif", 18));
    介面.註冊點擊(處理點擊); 介面.註冊按鍵(處理按鍵);
    變數 離線 = 音訊.建立離線裝置(); 變數 示波音 = 離線.建立音調(440, 0.2d);
    示波音.播放(); 離線.產生樣本(512); 波形 = 離線.產生樣本(512); 離線.釋放();
};
變數 繪製 = 函式() {
    比例 = 畫.最大值(0.01d, 畫.最小值(介面.寬度() / 1120.0d, 介面.高度() / 780.0d));
    左邊 = (介面.寬度() - 1120 * 比例) / 2; 上邊 = (介面.高度() - 780 * 比例) / 2;
    如果 (旋律中 && 畫.毫秒() >= 下個音符時間) {
        如果 (旋律位置 < 長度(旋律)) { 彈奏(旋律[旋律位置]); 旋律位置 += 1; 下個音符時間 = 畫.毫秒() + 280; }
        否則 { 旋律中 = 假; 訊息 = "旋律結束。每個音符都由星泉程式觸發。"; }
    }
    畫.背景(12, 24, 33); 畫.推入矩陣(); 畫.平移(左邊, 上邊); 畫.縮放(比例); 畫.停用描邊();
    文字("星泉 · 聲音實驗", 40, 48, 16, 93, 213, 186);
    文字("聲音工坊", 38, 111, 48, 236, 247, 244);
    文字("彈奏八個音符，讓音量、方向與音高成為你的創作工具。", 40, 150, 19, 155, 179, 187);
    迴圈 (變數 項 = 0; 項 < 8; 項++) {
        畫.填色(224, 238, 233); 如果 (項 == 活動琴鍵 && 畫.毫秒() - 琴鍵時間 < 220) { 畫.填色(94, 216, 186); }
        畫.矩形(40 + 項 * 130, 190, 120, 180, 13);
        文字(音名[項], 74 + 項 * 130, 292, 28, 20, 50, 49);
        文字("鍵盤", 78 + 項 * 130, 328, 12, 84, 112, 108);
        畫.填色(84, 112, 108); 畫.文字大小(15); 畫.文字(項 + 1, 94 + 項 * 130, 350);
    }
    按鈕("聽一段旋律", 40, 404, 236, 旋律中); 按鈕("低音循環", 294, 404, 236, 循環中);
    按鈕("播放原創音檔", 548, 404, 236, 假); 按鈕("停止所有聲音", 802, 404, 236, 假);
    變數 音量名稱 = "標準"; 如果 (音量 < 0.5d) { 音量名稱 = "輕柔"; }
    按鈕("音量 · " + 音量名稱, 40, 490, 320, 假); 按鈕("聲像 · " + 聲像名稱, 380, 490, 320, 假); 按鈕("音高 · " + 音高名稱, 720, 490, 320, 假);
    畫.填色(20, 38, 48); 畫.矩形(40, 574, 1000, 118, 14);
    文字("實際音訊樣本 · 四四〇赫茲", 58, 604, 14, 130, 166, 172);
    畫.描邊(92, 213, 186); 畫.描邊粗細(1.5d);
    迴圈 (變數 項 = 1; 項 < 512; 項++) { 畫.線段(58 + (項 - 1) * 1.89d, 650 - 波形[(項 - 1) * 2] * 100, 58 + 項 * 1.89d, 650 - 波形[項 * 2] * 100); }
    畫.停用描邊(); 文字(訊息, 40, 734, 18, 205, 226, 227);
    文字("數字鍵一至八彈奏　空白鍵停止　左右聲道建議使用耳機", 40, 763, 13, 128, 156, 167);
    畫.彈出矩陣();
};
畫.執行(設定, 繪製);
如果 (準備完成) { 裝置.釋放(); }
